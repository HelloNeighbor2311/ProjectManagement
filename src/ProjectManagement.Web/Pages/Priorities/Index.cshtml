@page
@using ProjectManagement.Localization
@using ProjectManagement.Permissions
@using Microsoft.AspNetCore.Authorization
@using ProjectManagement.Web.Pages.Projects
@using Microsoft.Extensions.Localization
@inject IAuthorizationService AuthorizationService
@model IndexModel
@inject IStringLocalizer<ProjectManagementResource> L
@section scripts
{
    <abp-script src="/Pages/Priorities/Index.js" />
}
<abp-card>
    <abp-card-header>
        <abp-column size-md="_6">
            <abp-card-title>@L["Priorities"]</abp-card-title>
        </abp-column>
        <abp-column size-md="_11" class="text-end">
            @if (await AuthorizationService.IsGrantedAsync(ProjectManagementPermissions.Priorities.Create))
            {
                <abp-button id="NewPriorityButton"
                            text="@L["NewPriority"].Value"
                            icon="plus"
                            button-type="Primary" />
            }
        </abp-column>
    </abp-card-header>
    <abp-card-body>
        <div class="mb-3 p-2 rounded">
            <div class="input-group rounded overflow-hidden" style="background-color: #FAF7F7;">
                <input id="PrioritySearch"
                       type="search"
                       class="form-control border-0"
                       style="background-color: #FAF7F7;"
                       placeholder="@L["Search"]"
                       aria-label="@L["Search"]" />
                <button id="PrioritySearchButton" class="btn btn-primary px-4" type="button" aria-label="@L["Search"]">
                    <i class="fa fa-search"></i>
                </button>
            </div>
        </div>
        <abp-table striped-rows="true" id="PriorityTable"></abp-table>
    </abp-card-body>
</abp-card>
