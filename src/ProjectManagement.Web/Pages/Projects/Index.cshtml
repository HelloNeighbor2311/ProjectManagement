@page
@using ProjectManagement.Localization
@using ProjectManagement.Permissions
@using Microsoft.AspNetCore.Authorization
@using ProjectManagement.Web.Pages.Projects
@using Microsoft.Extensions.Localization
@inject IAuthorizationService AuthorizationService
@model IndexModel
@inject IStringLocalizer<ProjectManagementResource> L
@section scripts
{
    <abp-script src="/Pages/Projects/Index.js" />
}
<abp-card>
    <abp-card-header>
        <abp-column size-md="_6">
            <abp-card-title>@L["Projects"]</abp-card-title>
        </abp-column>
        <abp-column size-md="_11" class="text-end">
             @if (await AuthorizationService.IsGrantedAsync(ProjectManagementPermissions.Projects.Create))
                {
            <abp-button id="NewProjectButton"
                        text="@L["NewProject"].Value"
                        icon="plus"
                        button-type="Primary" />
                }
        </abp-column>
    </abp-card-header>
    <abp-card-body>
        @* Search UI: user enters keyword here, then clicks magnifier or presses Enter to trigger DataTable reload. *@
        <div class="mb-3 p-2 rounded">
            <div class="input-group rounded overflow-hidden" style="background-color: #FAF7F7;">
                <input id="ProjectSearch"
                       type="search"
                       class="form-control border-0"
                       style="background-color: #FAF7F7;"
                       placeholder="@L["Search"]"
                       aria-label="@L["Search"]" />
                <button id="ProjectSearchButton" class="btn btn-primary px-4" type="button" aria-label="@L["Search"]">
                    <i class="fa fa-search"></i>
                </button>
            </div>
        </div>
        <abp-table striped-rows="true" id="ProjectTable"></abp-table>
    </abp-card-body>
</abp-card>
